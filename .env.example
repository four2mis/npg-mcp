# ── NginxProxyGuard MCP Server ──────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Your NPG API instance URL
NPG_BASE_URL=http://npg-api:8080

# NPG login credentials (required for auto-auth)
NPG_USERNAME=your_username
NPG_PASSWORD=your_password

# MCP server port (listen)
MCP_PORT=8081