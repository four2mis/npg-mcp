# ── NginxProxyGuard MCP Server ──────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Your NPG API instance URL
NPG_BASE_URL=http://npg-api:8080

# ── NPG API authentication ─────────────────────────────────────────
# Long-lived API token (required). Create one in the NPG web UI or via
# POST /api/v1/api-tokens. The token looks like: ng_xxxxxxxxxxxxxxxxxxxxxxxx
NPG_API_TOKEN=ng_your_api_token_here

# MCP server port (listen)
MCP_PORT=8081

# REQUIRED for HTTP deployments: bearer token for the MCP endpoint.
# Every MCP client must send `Authorization: Bearer <token>`.
# Generate one, e.g.:  openssl rand -hex 32
# If left empty, the endpoint runs OPEN (no auth) for local/LAN-only use.
MCP_API_TOKEN=

# Restrict which Host headers the MCP endpoint accepts (comma-separated host:port).
# Defaults to localhost. For reverse-proxy access, add your proxy's public host.
#MCP_ALLOWED_HOSTS=localhost:8081,proxy.example.com:443

# Restrict cross-origin requests (comma-separated origins). Empty = only same-origin/loopback.
# For reverse-proxy access, add your proxy origin, e.g.  https://proxy.example.com
#MCP_ALLOWED_ORIGINS=https://proxy.example.com

# Keep DNS-rebinding protection on (default true). Disable only if it breaks your proxy.
#MCP_REBINDING_PROTECTION=true

# MCP server bind host
MCP_HOST=0.0.0.0

# MCP transport mode: "http" for network deployment, "stdio" for direct pipe.
# Docker images default to "http". Only change if running standalone.
#MCP_TRANSPORT=http

# Container log verbosity: DEBUG, INFO (default), WARNING, ERROR.
# INFO logs one line per inbound MCP request (rpc, tool name, client IP, status,
# duration) and one line per outbound NPG API call (method, path, status, ms).
# Tokens and request/response bodies are NEVER logged.
#NPG_LOG_LEVEL=INFO

# Layered toolset exposure: how many tools the MCP endpoint exposes.
#   read     = 129 strictly read-only tools (get/list/view/download/check/detect)
#   standard = 228 tools (no deletes, bans, restores, password changes, etc.)
#   full     = 274 tools (everything; the default)
#NPG_TOOL_LEVEL=full

# Dry-run safety mode: when set to a truthy value (1, true, yes, on), every
# mutating tool returns the exact request it WOULD send (method, path, body)
# instead of executing — nothing is ever written. Use it to rehearse a first
# deployment against a live instance safely. Set to 0/false/no to disable.
#NPG_DRY_RUN=0